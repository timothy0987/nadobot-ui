# testnet or mainnet - controls all the default URLs/chain id below.
# Start on testnet. Only switch to mainnet once you've validated the bot end-to-end.
NADO_ENV=testnet

PRIVATE_KEY=0xYourPrivateKeyHere

# --- Network (auto-filled from NADO_ENV, override only if you need a custom RPC/gateway) ---
# RPC_URL=
# CHAIN_ID=
# NADO_GATEWAY_URL=
# NADO_SUBSCRIBE_URL=
# NADO_TRIGGER_URL=
# EXPLORER_URL=

SUBACCOUNT_NAME=default
PRODUCT_SYMBOL=BTC-PERP

# --- Builder code: earn a fee on every order the bot places. Get an ID from the Nado team first;
# a non-zero fee rate with BUILDER_ID=0 is rejected. Fee rate is in 0.1bps units (10 = 1bps = 0.01%).
BUILDER_ID=0
BUILDER_FEE_RATE_TENTH_BPS=0

# --- Entry strategy: buy when price drops this % from its recent high since the bot started ---
ENABLE_DIP_BUY=true
TRADE_DROP_PERCENTAGE=0.05
TRADE_AMOUNT=0.001
# Hard cap on total position size (base units). Dip-buys that would push past it are skipped.
MAX_POSITION_SIZE=0.005

# --- Exit protection: keeps exactly one stop-loss + one take-profit on ANY open position (bot-opened or
# manual), resized whenever the position changes. They are Nado server-side trigger orders, so the exit
# still fires even if this bot process (or your machine) goes offline.
ENABLE_POSITION_PROTECTION=true
STOP_LOSS_PERCENT=0.05
TAKE_PROFIT_PERCENT=0.10
PROTECTION_CHECK_INTERVAL_SECONDS=30

# --- Alerts (optional): buys, protection placed/resized, position closed, errors ---
# Telegram: create a bot with @BotFather, then message it and read your chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Read-only status endpoint (GET /status) used by the dashboard. Railway sets PORT for you.
# PORT=8080
