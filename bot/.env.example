# testnet or mainnet - controls all the default URLs/chain id below.
# Start on testnet. Only switch to mainnet once you've validated the bot end-to-end.
NADO_ENV=testnet

PRIVATE_KEY=0xYourPrivateKeyHere

# --- Network (auto-filled from NADO_ENV, override only if you need a custom RPC/gateway) ---
# RPC_URL=
# CHAIN_ID=
# NADO_GATEWAY_URL=
# NADO_SUBSCRIBE_URL=
# NADO_TRIGGER_URL=
# EXPLORER_URL=

SUBACCOUNT_NAME=default
PRODUCT_SYMBOL=BTC-PERP

BUILDER_ID=0
BUILDER_FEE_RATE_TENTH_BPS=0

# --- Entry strategy: buy when price drops this % from its recent high since the bot started ---
ENABLE_DIP_BUY=true
TRADE_DROP_PERCENTAGE=0.05
TRADE_AMOUNT=0.001

# --- Exit protection: attach stop-loss/take-profit to ANY open position (bot-opened or manual) ---
# These are placed as Nado server-side trigger orders, so the exit still fires even if this
# bot process (or your machine) goes offline.
ENABLE_POSITION_PROTECTION=true
STOP_LOSS_PERCENT=0.05
TAKE_PROFIT_PERCENT=0.10
PROTECTION_CHECK_INTERVAL_SECONDS=30
